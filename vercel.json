{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run lpg-mobile:build",
  "installCommand": "cd apps/lpg-mobile && npm ci",
  "outputDirectory": "apps/lpg-mobile/dist",
  "ignoreCommand": "node scripts/vercel-ignore.mjs lpg",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run lpg-mobile:build",
  "installCommand": "npm --prefix apps/lpg-mobile ci",
  "outputDirectory": "apps/lpg-mobile/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

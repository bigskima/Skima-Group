{
  "name": "skima-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Universal AI-first platform foundation for logistics, commerce, mobility, and fulfillment.",
  "type": "module",
  "scripts": {
    "check": "deno check packages/core/src/index.ts packages/config/src/index.ts packages/events/src/index.ts packages/adapters/src/index.ts packages/auth/src/index.ts packages/engines/src/index.ts packages/modules/src/index.ts packages/mobile-design/src/index.ts supabase/functions/health/index.ts supabase/functions/api-gateway/index.ts supabase/functions/runtime-worker/index.ts supabase/functions/payment-webhook/index.ts supabase/functions/webhook-sandbox-receiver/index.ts scripts/supabase-runtime.ts scripts/supabase-remote.ts scripts/bootstrap-platform-admin.ts scripts/provision-platform-admin.ts scripts/provision-platform-wallets.ts scripts/list-platform-admin-roles.ts scripts/validate-foundation.ts scripts/verify-remote-gate.ts scripts/verify-backend-lifecycle.ts scripts/verify-webhook-dead-letter.ts scripts/verify-application-document-lifecycle.ts scripts/verify-driver-vehicle-onboarding.ts scripts/verify-organization-staff-lifecycle.ts scripts/verify-catalog-availability-lifecycle.ts scripts/verify-order-operations-lifecycle.ts scripts/verify-finance-communication-lifecycle.ts scripts/verify-public-reference-runtime.ts scripts/verify-lpg-payment-reservation.ts scripts/verify-lpg-lifecycle.ts scripts/verify-frontend-session-context.ts scripts/verify-financial-policy-governance.ts",
    "lint": "deno lint packages scripts supabase/functions",
    "validate": "deno run --allow-read scripts/validate-foundation.ts",
    "frontend:build": "vite build --config apps/admin/vite.config.ts",
    "frontend:check": "tsc --noEmit -p apps/admin/tsconfig.json",
    "frontend:dev": "vite --config apps/admin/vite.config.ts --host 127.0.0.1 --port 5174",
    "frontend:test": "vitest run --config apps/admin/vitest.config.ts",
    "frontend:validate": "deno run --allow-read scripts/validate-frontend-foundation.ts",
    "mobile:build": "vite build --config apps/mobile/vite.config.ts",
    "mobile:check": "tsc --noEmit -p apps/mobile/tsconfig.json",
    "mobile:dev": "vite --config apps/mobile/vite.config.ts --host 127.0.0.1 --port 5175",
    "mobile:test": "vitest run --config apps/mobile/vitest.config.ts",
    "mobile:validate": "deno run --allow-read scripts/validate-mobile-foundation.ts",
    "lpg-mobile:build": "npm --prefix apps/lpg-mobile run build:web",
    "lpg-mobile:check": "npm --prefix apps/lpg-mobile run check",
    "lpg-mobile:dev": "npm --prefix apps/lpg-mobile start",
    "lpg-mobile:android": "npm --prefix apps/lpg-mobile run android",
    "lpg-mobile:ios": "npm --prefix apps/lpg-mobile run ios",
    "lpg-mobile:web": "npm --prefix apps/lpg-mobile run web",
    "lpg-mobile:test": "npm --prefix apps/lpg-mobile test",
    "verify": "npm run check && npm run lint && npm run validate && npm run frontend:validate && npm run mobile:validate && npm run financial-governance:verify",
    "financial-governance:verify": "deno run --allow-read scripts/verify-financial-policy-governance.ts",
    "supabase:link": "deno run --allow-env --allow-run --allow-read scripts/supabase-remote.ts link",
    "supabase:db:push": "deno run --allow-env --allow-run --allow-read scripts/supabase-remote.ts db-push",
    "supabase:db:reset:linked": "deno run --allow-env --allow-run --allow-read scripts/supabase-remote.ts db-reset-linked",
    "supabase:functions:deploy": "deno run --allow-env --allow-run --allow-read scripts/supabase-remote.ts functions-deploy",
    "supabase:remote:status": "deno run --allow-env --allow-run --allow-read --allow-net scripts/supabase-remote.ts status",
    "supabase:remote:gate": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-remote-gate.ts",
    "supabase:backend:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-backend-lifecycle.ts",
    "supabase:webhook:dead-letter": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-webhook-dead-letter.ts",
    "supabase:applications:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-application-document-lifecycle.ts",
    "supabase:drivers:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-driver-vehicle-onboarding.ts",
    "supabase:staff:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-organization-staff-lifecycle.ts",
    "supabase:catalog:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-catalog-availability-lifecycle.ts",
    "supabase:orders:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-order-operations-lifecycle.ts",
    "supabase:finance-communication:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-finance-communication-lifecycle.ts",
    "supabase:public-references:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-public-reference-runtime.ts",
    "supabase:lpg-payment:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-lpg-payment-reservation.ts",
    "supabase:lpg-lifecycle:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-lpg-lifecycle.ts",
    "supabase:frontend-session:e2e": "deno run --allow-env --allow-net --allow-read --allow-run scripts/verify-frontend-session-context.ts",
    "supabase:bootstrap-admin": "deno run --allow-env --allow-net --allow-read --allow-run scripts/bootstrap-platform-admin.ts",
    "supabase:data:reset": "deno run --allow-env --allow-net --allow-read --allow-run scripts/reset-remote-application-data.ts",
    "supabase:provision-admin": "deno run --allow-env --allow-net --allow-read --allow-run scripts/provision-platform-admin.ts",
    "supabase:provision-platform-wallets": "deno run --allow-env --allow-net --allow-read --allow-run scripts/provision-platform-wallets.ts",
    "supabase:admin-roles:list": "deno run --allow-env --allow-net --allow-read --allow-run scripts/list-platform-admin-roles.ts",
    "supabase:status": "supabase status",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}

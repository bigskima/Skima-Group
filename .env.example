# SKIMA client environment template
# Keep this file limited to client-safe configuration and placeholders.
# Configure all server/private secrets only in managed secret stores.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<client-safe-key>
SUPABASE_PROJECT_REF=<project-ref>

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<client-safe-key>
VITE_API_GATEWAY_URL=https://<project-ref>.supabase.co/functions/v1/api-gateway

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<client-safe-key>
EXPO_PUBLIC_API_GATEWAY_URL=https://<project-ref>.supabase.co/functions/v1/api-gateway
EXPO_PUBLIC_EAS_PROJECT_ID=<eas-project-id>

# Client basemap rendering is deliberately keyless. LocationIQ remains a
# server-side geocoding/routing provider and must never be used as a public
# browser tile URL without a supported client credential.
EXPO_PUBLIC_MAP_TILE_PROVIDER=carto_voyager
EXPO_PUBLIC_MAP_TILE_URL=https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors, © CARTO
EXPO_PUBLIC_MAP_TILE_MAX_ZOOM=19

